# --- Auth ---
# Generate strong values with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-at-least-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# --- OTP ---
# Leave DEMO_OTP_ENABLED unset or "false" in any environment real users touch.
# "true" is for local development only — it disables real OTP delivery and
# always uses DEMO_OTP_CODE, and echoes the code back in the API response.
DEMO_OTP_ENABLED=false
DEMO_OTP_CODE=123456

# --- Database (Vercel Postgres / Neon) ---
# Auto-populated by Vercel when you attach a Postgres database to this
# project (Vercel Dashboard -> Storage -> Create Database -> Postgres).
# Do not set these by hand unless you're running a non-Vercel Postgres.
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# --- Rate limiting (Upstash Redis) ---
# Auto-populated if you add the Upstash integration from the Vercel
# Marketplace. Without these set, rate limiting is silently skipped —
# see src/lib/rate-limit.ts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
