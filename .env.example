# --- Auth ---
# Generate strong values with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-at-least-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# --- OTP ---
# Leave DEMO_OTP_ENABLED unset or "false" in any environment real users touch.
# "true" is for local development only — it disables real OTP delivery and
# always uses DEMO_OTP_CODE, and echoes the code back in the API response.
DEMO_OTP_ENABLED=false
DEMO_OTP_CODE=123456

# --- Database (Vercel Postgres via Prisma Postgres integration) ---
# Auto-populated by Vercel when you use "Connect to Project" from the
# Prisma Postgres database page (Storage tab). NOTE: the actual names
# Vercel's Prisma Postgres integration creates are POSTGRES_PRISMA_DATABASE_URL
# and POSTGRES_URL (not POSTGRES_PRISMA_URL / POSTGRES_URL_NON_POOLING —
# those are the names Vercel's OWN native Postgres product uses, which is
# a different product). Do not set these by hand.
POSTGRES_PRISMA_DATABASE_URL=
POSTGRES_URL=

# --- Rate limiting (Upstash Redis) ---
# Auto-populated if you use "Connect to Project" from the Upstash for
# Redis database page (Storage tab). NOTE: Vercel's Upstash integration
# names these UPSTASH_REDIS_KV_REST_API_URL / UPSTASH_REDIS_KV_REST_API_TOKEN
# (not the plain UPSTASH_REDIS_REST_URL/TOKEN shown in Upstash's own generic
# docs). Without these set, rate limiting is silently skipped — see
# src/lib/rate-limit.ts.
UPSTASH_REDIS_KV_REST_API_URL=
UPSTASH_REDIS_KV_REST_API_TOKEN=
